# Copy to .env (git-ignored) and fill in. Never commit real tokens.
# Default stays the simulator so CI and demos need no network.
SENSOR_SOURCE=simulator
LEAF_TEMP_OFFSET_C=-2.0
# Growth stage for the VPD target: seedling (or clone), veg, flower, late_flower.
# Default veg is 0.8-1.2 kPa leaf VPD. See README.
GROW_STAGE=veg

# Non-root container cannot create ./data. /tmp is writable.
# Mount a volume and override the path when the audit log should persist.
AUDIT_DB_PATH=/tmp/audit.db

# --- Home Assistant (AC Infinity, read-only) ---
# Compose sibling: HA_URL=http://homeassistant:8123
# HA on another machine: HA_URL=http://homeassistant.local:8123
# SENSOR_SOURCE=homeassistant
# HA_URL=http://homeassistant:8123
# HA_TOKEN=your-long-lived-access-token
# HA_DEVICE_PREFIX=the_garden
#
# Optional. Folder for scripts/aws-poc.ps1 up -WithHA when it is not .\ha-config
# in this checkout. -HaConfigPath and the GROW_HA_CONFIG_PATH environment
# variable win over this line. Leave it unset to use the /config mount of the
# running homeassistant container.
# GROW_HA_CONFIG_PATH=\\wsl.localhost\Ubuntu\home\colem\src\grow-room-platform\ha-config
#
# The Garden entity IDs (UIS Controller AI+ CTR89Q + internal probe).
# These match the defaults when HA_DEVICE_PREFIX=the_garden, so this tent
# only needs SENSOR_SOURCE, HA_URL, and HA_TOKEN. Set a variable to blank
# to skip that sensor. HA often reports VPD in psi; the service converts it
# to kPa and also returns the original number and unit.
# HA_TEMP_ENTITY=sensor.the_garden_controller_temperature
# HA_HUMIDITY_ENTITY=sensor.the_garden_controller_humidity
# HA_VPD_ENTITY=sensor.the_garden_controller_vpd
# HA_STATUS_ENTITY=binary_sensor.the_garden_status
# HA_PROBE_TEMP_ENTITY=sensor.the_garden_probe_sensor_probe_temperature
# HA_PROBE_HUMIDITY_ENTITY=sensor.the_garden_probe_sensor_probe_humidity
# HA_PROBE_VPD_ENTITY=sensor.the_garden_probe_sensor_probe_vpd
# HA_CO2_ENTITY=
#
# Active UIS devices. Each slug maps to:
#   binary_sensor.<prefix>_<slug>_status
#   binary_sensor.<prefix>_<slug>_state
#   sensor.<prefix>_<slug>_current_power
#   select.<prefix>_<slug>_active_mode
# Ports 4–7 are omitted (unused / unavailable). Add a slug when one is live:
# HA_PORT_DEVICES=port_1,humidifier,oscillating_fans,ventilation_fan,port_4
# HA_PORT_DEVICES=port_1,humidifier,oscillating_fans,ventilation_fan
